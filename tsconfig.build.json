{
  // Publish-only build: emit JS + .d.ts into dist/ for npm consumers (the hosted-product
  // embedding case). Development and tests still run the raw .ts via strip-types; this
  // config exists ONLY to produce the distributable artifact.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**", "**/*.test.ts"]
}
